# Copy to backend/.env and adjust
APP_ENV=development
FLASK_APP=app
LOG_LEVEL=DEBUG
# Main database
DATABASE_URL=postgresql+psycopg://manojtungala@localhost:5432/nipunacrm
# Dev replica with staging data, used when APP_ENV=development (flask create-dev-db, flask seed-dev)
DEV_DATABASE_URL=postgresql+psycopg://manojtungala@localhost:5432/nipunacrm-dev
# Tests use DATABASE_URL + "_test" unless this is set
# TEST_DATABASE_URL=postgresql+psycopg://manojtungala@localhost:5432/nipunacrm_test
SECRET_KEY=change-me
# AI Copilot (optional; without a key the rule-based fallback is used)
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# UPLOAD_DIR=
