# Copy to backend/.env and adjust
APP_ENV=development
FLASK_APP=app
LOG_LEVEL=DEBUG
# Main database
DATABASE_URL=postgresql+psycopg://manojtungala@localhost:5432/nipunacrm
# Dev replica with staging data, used when APP_ENV=development (flask create-dev-db, flask seed-dev)
DEV_DATABASE_URL=postgresql+psycopg://manojtungala@localhost:5432/nipunacrm-dev
# Tests use DATABASE_URL + "_test" unless this is set
# TEST_DATABASE_URL=postgresql+psycopg://manojtungala@localhost:5432/nipunacrm_test
SECRET_KEY=change-me
# AI Copilot (optional; without a key the rule-based fallback is used)
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# UPLOAD_DIR=
# Nipuna LMS: where the lms-sync job posts admission / course / finance events (local LMS on :5060).
# LMS_SERVICE_KEY is the LMS's CRM_SERVICE_KEY; get it from the LMS owner, never commit it.
LMS_BASE_URL=http://127.0.0.1:5060
LMS_SERVICE_KEY=change-me
# The LMS web app's address (not the API): used for the "Open in LMS" links on Waiting for batch
LMS_WEB_URL=http://127.0.0.1:5174
# LMS_TIMEOUT_SECONDS=10
# Round 3: deliver each request's events right after it commits (0 = off; the worker / job still deliver)
# LMS_PUSH_ON_COMMIT=1
# LMS_PUSH_TIMEOUT_SECONDS=3

# WhatsApp templates (Pinbot). Nothing is sent unless WHATSAPP_ENABLED=1 and the URL and key are set.
# WHATSAPP_API_URL = the messages URL for your number: https://partnersv1.pinbot.ai/v3/<number id>/messages
# WHATSAPP_TEST_NUMBERS: comma-separated, with country code; when set, only these numbers are messaged
WHATSAPP_ENABLED=0
WHATSAPP_API_URL=
WHATSAPP_API_KEY=change-me
WHATSAPP_TEST_NUMBERS=
# WHATSAPP_WEBHOOK_TOKEN: the secret the provider sends (header X-Webhook-Token or ?token=) to POST /api/v1/webhooks/whatsapp
WHATSAPP_WEBHOOK_TOKEN=
# WHATSAPP_TIMEOUT_SECONDS=10
# WHATSAPP_PUSH_ON_COMMIT=1
# WHATSAPP_MAX_AGE_HOURS=24
# WHATSAPP_INVOICE_CHANNEL=your Nipuna counsellor
