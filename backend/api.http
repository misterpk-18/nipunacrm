# Nipuna CRM API — request collection (VS Code REST Client / JetBrains HTTP client).
# Generated from the Flask URL map. Log in first, then paste the token into @token.
@base = http://127.0.0.1:5050
@token = paste-token-here

### Log in
POST {{base}}/api/v1/auth/login
Content-Type: application/json

{"email": "admin@nipuna.test", "password": "Nipuna-staging-1"}

